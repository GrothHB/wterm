#!/bin/dash

mkdir -p afl_in afl_out_klaster
rm -f afl_in/*.txt

AFL_USE_ASAN=1 afl-clang-fast -O0 -g -Wall -Wextra -DHISTORY_MAX_SIZE=3 \
    redef.c ../src/tab_compl.c ../src/rvs_mode.c ../src/sparse.c create_chaos.c -o fuzzer_bin || exit 1

> term.dict
cat << 'EOF' >> term.dict
esc_A="\x1b[A"
esc_B="\x1b[B"
esc_C="\x1b[C"
esc_D="\x1b[D"
tab="\x09"
enter="\x0a"
ctrl_r="\x12"
backspace="\x7f"
escape="\x1b"
pipe="|"
ampersand="&"
redirect_out=">"
redirect_in="<"
dquote="\""
squote="'"
slash="/"
dot="."
EOF

ls /bin | grep -E '^[a-z]{2,6}$' | head -n 40 | awk '{ printf "cmd_%s=\"%s\"\n", $1, $1 }' >> term.dict

awk 'BEGIN {
    for(i=1; i<=20; i++) printf "komenda_nr_%d\n", i;
    printf "\033[A\033[A\033[A\033[B\033[B\n";
    printf "\022komenda_nr_30\022\177\033\n";
}' > afl_in/history_and_rvs.txt

printf "ls /usr/bi\011\n" > afl_in/tab_abuse.txt
printf "l\011s -1 | \011gr\011 > file" >> afl_in/tab_abuse.txt
printf "cat plik | gr\011\n" >> afl_in/tab_abuse.txt
printf "cd \"/home/user/dir with spaces\011\n" >> afl_in/tab_abuse.txt
awk 'BEGIN { for(i=1; i<=10; i++) printf "cd \"/usr/local\011\011\011\n"; }' >> afl_in/tab_abuse.txt

awk 'BEGIN {
    for(i=1; i<=10; i++) {
        for(j=1; j<=400; j++) printf "A";
        printf "\033[D\033[D\177\n";
    }
}' > afl_in/oversized.txt

awk 'BEGIN {
    for(i=1; i<=20; i++) printf "echo \\\"test\\\"\177\177\177\177\033[A\n";
}' > afl_in/structural_chaos.txt

cp corpus_min/* afl_in/ 2>/dev/null


i=1
while [ "$i" -le 19 ]; do
    afl-fuzz -i - -o afl_out_klaster -S slave$i -x term.dict -- ./fuzzer_bin >/dev/null 2>&1 &
    i=$((i + 1))
done

afl-fuzz -i - -o afl_out_klaster -M master -x term.dict -- ./fuzzer_bin

