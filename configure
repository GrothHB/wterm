#!/bin/sh
# simple configure to enable for usage of strlcpy
# and reallocarray from OpenBSD

rm -f config.h
echo "#ifndef CONFIG_H" >src/config.h
echo "#define CONFIG_H" >>src/config.h

# checking if we have strlcpy:
if echo '#include <stdlib.h>
	 #include <stdio.h>
	 #include <string.h>
	 int
	 main(void)
	 {
		char b[2];
		strlcpy(b, "a", 2);
		return (0);
	 }' | cc -x c - -o /dev/null 2>/dev/null; then
	echo "#define HAVE_STRLCPY 1">>src/config.h
fi

if echo '#include <stdio.h>
	 #include <stdlib.h>
	 int
	 main(void)
	 {
		void *p = reallocarray(NULL, 1, sizeof(void *));
		return (0);
	 }' | cc -x c - -o /dev/null 2>/dev/null; then
	echo "#define HAVE_REALLOCARRAY 1" >>src/config.h
fi
echo "#endif /* CONFIG_H */">>src/config.h
